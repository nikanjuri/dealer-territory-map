{
  "name": "dealer-territory-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci --no-audit --no-fund",
    "prepare:map": "node scripts/prepare-maplibre-worker.mjs",
    "update:postal": "node scripts/prepare-postal-directory.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:amit-retail": "tsx scripts/migrate-amit-retail-supabase.ts",
    "db:import-dealers": "tsx scripts/import-dealer-staging.ts",
    "db:import-new-dealers": "tsx scripts/import-new-dealer-files.ts",
    "db:auto-verify-dealer-areas": "tsx scripts/auto-verify-dealer-areas.ts",
    "db:verify-dealers": "tsx scripts/verify-dealer-import.ts",
    "db:audit-dealer-locations": "tsx scripts/audit-dealer-locations.ts",
    "db:normalize-dealers": "tsx scripts/normalize-dealer-data.ts",
    "db:apply-area-normalization": "tsx scripts/apply-area-normalization-preview.ts",
    "dev": "npm run prepare:map && next dev --port 5740",
    "prebuild": "npm run prepare:map",
    "build": "next build",
    "start": "next start --port 5740",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern public/pdf.worker.min.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run test && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.9.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/google.maps": "^3.66.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
