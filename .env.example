# Neon Postgres and Neon Auth (server only; values are injected by Vercel).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Browser-restricted Google Maps JavaScript API key. Optional while the
# OpenStreetMap/MapLibre transition fallback remains enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-only key restricted to the Google Routes API. Never reuse the browser
# key for server-side route optimization.
GOOGLE_ROUTES_API_KEY=

# Optional dedicated HMAC secret for short-lived, unsaved route previews.
# When omitted, the server derives preview signatures from another server-only
# project secret so local and existing deployments remain compatible.
ROUTE_PREVIEW_SECRET=

# Optional server-only WhatsApp notifications for commerce orders.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# One-time legacy import only. Never expose or commit the service-role key.
SUPABASE_MIGRATION_URL=
SUPABASE_SERVICE_ROLE_KEY=
